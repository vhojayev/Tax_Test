{
  "manifest_version": 3,
  "name": "JobFill",
  "version": "0.1.0",
  "description": "Scores job listings against your resume, flags recruiters and aggregators, and fills application forms. Local-first; never submits.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "action": {
    "default_title": "JobFill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.workday.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.icims.com/*",
        "*://*.jobvite.com/*",
        "*://*.bamboohr.com/*",
        "*://*.workable.com/*",
        "*://*.breezy.hr/*",
        "*://*.recruitee.com/*",
        "*://*.taleo.net/*",
        "*://*.successfactors.com/*",
        "*://*.teamtailor.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.indeed.com/*",
        "*://*.linkedin.com/*",
        "*://www.google.com/search*"
      ],
      "js": [
        "jobs.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}