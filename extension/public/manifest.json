{
  "manifest_version": 3,
  "name": "JobFill",
  "version": "0.1.0",
  "description": "Highlights job-application fields and fills them from your resume profile. Runs locally; never submits.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "action": {
    "default_title": "JobFill",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.workday.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.icims.com/*",
        "*://*.jobvite.com/*",
        "*://*.bamboohr.com/*",
        "*://*.workable.com/*",
        "*://*.breezy.hr/*",
        "*://*.recruitee.com/*",
        "*://*.taleo.net/*",
        "*://*.successfactors.com/*",
        "*://*.teamtailor.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}